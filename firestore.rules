rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Función auxiliar para verificar admin
    // Función auxiliar para verificar admin (Ahora permite acceso público para el panel con PIN)
    function isAdmin() {
      return true; // Permitimos acceso ya que el control se hace por PIN en el frontend
    }

    // Colección de Fechas Disponibles
    match /available_dates/{dateId} {
      allow read, write: if true;
    }

    // Colección de Citas (Appointments)
    match /appointments/{appointmentId} {
      allow read, write: if true;
    }

    // Colección de Compras (Purchases)
    match /purchases/{purchaseId} {
      allow read, write: if true;
    }

    // Colección de Imágenes del Carrusel
    match /carousel_images/{imageId} {
      allow read, write: if true;
    }

    // Colección de Productos Destacados
    match /featured_products/{productId} {
      allow read, write: if true;
    }

    // Colección de Productos de la Tienda
    match /store_products/{productId} {
      allow read, write: if true;
    }

    // Regla por defecto para usuarios
    match /users/{userId} {
      allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }

    // Configuración del Sitio (Banco y Redes)
    match /site_settings/{settingId} {
      allow read, write: if true;
    }
  }
}
